diff --git a/src/Ryujinx.HLE/HOS/Services/Ssl/SslService/ServerTrustStore.cs b/src/Ryujinx.HLE/HOS/Services/Ssl/SslService/ServerTrustStore.cs
new file mode 100644
index 0000000..4721bc7
--- /dev/null
+++ b/src/Ryujinx.HLE/HOS/Services/Ssl/SslService/ServerTrustStore.cs
@@ -0,0 +1,98 @@
+// Research-only implementation. This is not a release core.
+using Ryujinx.HLE.HOS.Services.Ssl.Types;
+using System;
+using System.Collections.Generic;
+using System.Net.Security;
+using System.Security.Cryptography;
+using System.Security.Cryptography.X509Certificates;
+using System.Text;
+
+namespace Ryujinx.HLE.HOS.Services.Ssl.SslService
+{
+    // Roots are scoped to one SSL context, never added to the system store.
+    sealed class ServerTrustStore
+    {
+        public const int MaxImportBytes = 1024 * 1024;
+        private const int MaxImports = 71;
+        private readonly object _sync = new();
+        private readonly Dictionary<ulong, byte[][]> _imports = new();
+        private ulong _nextId;
+
+        public bool TryImport(CertificateFormat format, byte[] data, out ulong id)
+        {
+            id = 0;
+            if (data == null || data.Length == 0 || data.Length > MaxImportBytes ||
+                (format != CertificateFormat.Pem && format != CertificateFormat.Der)) return false;
+            X509Certificate2Collection collection = new();
+            try
+            {
+                if (format == CertificateFormat.Pem) collection.ImportFromPem(Encoding.ASCII.GetString(data));
+                else collection.Import(data);
+                if (collection.Count == 0 || collection.Count > 128) return false;
+                byte[][] certificates = new byte[collection.Count][];
+                for (int i = 0; i < collection.Count; i++)
+                {
+                    if (collection[i].HasPrivateKey) return false;
+                    certificates[i] = collection[i].RawData;
+                }
+                lock (_sync)
+                {
+                    if (_imports.Count >= MaxImports || _nextId == ulong.MaxValue) return false;
+                    id = _nextId++;
+                    _imports.Add(id, certificates);
+                    return true;
+                }
+            }
+            catch (CryptographicException) { return false; }
+            finally { foreach (X509Certificate2 c in collection) c.Dispose(); }
+        }
+
+        public bool Remove(ulong id)
+        {
+            lock (_sync) return _imports.Remove(id);
+        }
+
+        // A default system-valid chain is accepted; otherwise build a second
+        // chain rooted ONLY in explicitly imported context certificates. Never
+        // ignore a missing certificate or a hostname mismatch. Dates and normal
+        // chain constraints are enforced; revocation is not checked here, same
+        // as the pre-existing AuthenticateAsClient(..., checkRevocation:false).
+        public bool ValidateServerCertificate(object sender, X509Certificate certificate,
+            X509Chain presentedChain, SslPolicyErrors errors)
+        {
+            if (certificate == null ||
+                (errors & (SslPolicyErrors.RemoteCertificateNotAvailable | SslPolicyErrors.RemoteCertificateNameMismatch)) != 0)
+                return false;
+            if (errors == SslPolicyErrors.None) return true;
+            if ((errors & ~SslPolicyErrors.RemoteCertificateChainErrors) != 0) return false;
+            List<byte[]> roots = new();
+            lock (_sync)
+            {
+                foreach (byte[][] imported in _imports.Values) roots.AddRange(imported);
+            }
+            if (roots.Count == 0) return false;
+            X509Certificate2Collection owned = new();
+            try
+            {
+                using X509Chain chain = new();
+                chain.ChainPolicy.TrustMode = X509ChainTrustMode.CustomRootTrust;
+                chain.ChainPolicy.RevocationMode = X509RevocationMode.NoCheck;
+                chain.ChainPolicy.VerificationFlags = X509VerificationFlags.NoFlag;
+                chain.ChainPolicy.ApplicationPolicy.Add(new Oid("1.3.6.1.5.5.7.3.1")); // TLS server auth
+                foreach (byte[] raw in roots)
+                {
+                    X509Certificate2 root = new(raw);
+                    owned.Add(root);
+                    chain.ChainPolicy.CustomTrustStore.Add(root);
+                }
+                if (presentedChain != null)
+                    foreach (X509ChainElement element in presentedChain.ChainElements)
+                        chain.ChainPolicy.ExtraStore.Add(element.Certificate);
+                using X509Certificate2 leaf = new(certificate);
+                return chain.Build(leaf);
+            }
+            catch (CryptographicException) { return false; }
+            finally { foreach (X509Certificate2 c in owned) c.Dispose(); }
+        }
+    }
+}
