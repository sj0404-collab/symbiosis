+std::unique_ptr<WindowAdaptPass> MakeRetro(const Device& device, VkFormat frame_format) {
+    // Pull the live preset from the active launcher. Every parameter becomes a
+    // specialization constant, so one shader module covers every look and the
+    // driver can fold the disabled branches away entirely.
+    const auto preset = Symbiosis::GetLauncherCatalogue().ActiveRetroPreset();
+
+    const std::array<float, 8> values{{
+        preset.virtual_width,
+        preset.virtual_height,
+        preset.color_levels,
+        preset.dither,
+        preset.scanline,
+        preset.lcd_grid,
+        preset.saturation,
+        preset.contrast,
+    }};
+
+    std::array<VkSpecializationMapEntry, values.size()> entries{};
+    for (u32 i = 0; i < static_cast<u32>(values.size()); ++i) {
+        entries[i] = VkSpecializationMapEntry{
+            .constantID = i,
+            .offset = i * static_cast<u32>(sizeof(float)),
+            .size = sizeof(float),
+        };
+    }
+
+    const VkSpecializationInfo spec{
+        .mapEntryCount = static_cast<u32>(entries.size()),
+        .pMapEntries = entries.data(),
+        .dataSize = values.size() * sizeof(float),
+        .pData = values.data(),
+    };
+
+    Symbiosis::LogInfo(Symbiosis::LogArea::Render,
+                       "retro filter: " + std::to_string(static_cast<int>(preset.virtual_width)) +
+                           "x" + std::to_string(static_cast<int>(preset.virtual_height)) +
+                           ", levels/channel " +
+                           std::to_string(static_cast<int>(preset.color_levels)) +
+                           ", dither " + std::to_string(static_cast<int>(preset.dither * 100)) +
+                           "%, scanline " +
+                           std::to_string(static_cast<int>(preset.scanline * 100)) + "%");
+
+    // Nearest sampling: any smoothing here would undo the pixelation the
+    // shader just performed.
+    return std::make_unique<WindowAdaptPass>(device, frame_format,
+                                             CreateNearestNeighborSampler(device),
+                                             BuildShader(device, PRESENT_RETRO_FRAG_SPV), &spec);
+}
+
 } // namespace Vulkan
