+
+            // A debug build ships an 80 MB libyuzu-android.so and a 24 MB
+            // Vulkan validation layer - 175 MB once installed. Neither is of
+            // any use to someone playing games, and the validation layer costs
+            // frame rate as well as space.
+            //
+            // The size is native, not Java: AGP maps the debug build type to
+            // CMAKE_BUILD_TYPE=Debug, so the emulator core is compiled -O0 with
+            // full DWARF. Building it RelWithDebInfo and stripping at package
+            // time keeps this variant debuggable on the Java side - which is
+            // what .debug and isDebuggable are for - while shipping optimised
+            // native code. It is also simply faster to run.
+            externalNativeBuild {
+                cmake {
+                    arguments += listOf("-DCMAKE_BUILD_TYPE=RelWithDebInfo")
+                }
+            }
+            ndk {
+                // Strip the .so in the APK; the unstripped copy is kept beside
+                // the build output for symbolising a crash later.
+                debugSymbolLevel = "SYMBOL_TABLE"
+            }
+            packaging {
+                jniLibs.excludes += setOf("**/libVkLayer_*.so")
+            }
         }
     }
 
