<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_navigation"
    app:startDestination="@id/nativeLauncherFragment">

    <fragment
        android:id="@+id/gamesFragment"
        android:name="org.yuzu.yuzu_emu.ui.GamesFragment"
        android:label="PlatformGamesFragment" />
        <action
            android:id="@+id/action_gamesFragment_to_homeSettingsFragment"
            app:destination="@id/homeSettingsFragment"
            app:enterAnim="@anim/nav_default_enter_anim"
            app:exitAnim="@anim/nav_default_exit_anim"
            app:popEnterAnim="@anim/nav_default_pop_enter_anim"
            app:popExitAnim="@anim/nav_default_pop_exit_anim" />

    <fragment
        android:id="@+id/homeSettingsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.HomeSettingsFragment"
        android:label="HomeSettingsFragment" />

    <fragment
        android:id="@+id/firstTimeSetupFragment"
        android:name="org.yuzu.yuzu_emu.fragments.SetupFragment"
        android:label="FirstTimeSetupFragment" >
        <action
            android:id="@+id/action_firstTimeSetupFragment_to_gamesFragment"
            app:destination="@id/gamesFragment"
            app:popUpTo="@id/firstTimeSetupFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/aboutFragment"
        android:name="org.yuzu.yuzu_emu.fragments.AboutFragment"
        android:label="AboutFragment" />

    <fragment
        android:id="@+id/licensesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.LicensesFragment"
        android:label="LicensesFragment" />

    <activity
        android:id="@+id/emulationActivity"
        android:name="org.yuzu.yuzu_emu.activities.EmulationActivity"
        android:label="EmulationActivity">
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="custom"
            app:argType="boolean"
            android:defaultValue="false" />
    </activity>

    <action
        android:id="@+id/action_global_emulationActivity"
        app:destination="@id/emulationActivity"
        app:launchSingleTop="true" />

    <activity
        android:id="@+id/settingsActivity"
        android:name="org.yuzu.yuzu_emu.features.settings.ui.SettingsActivity"
        android:label="SettingsActivity">
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game"
            app:nullable="true" />
        <argument
            android:name="menuTag"
            app:argType="org.yuzu.yuzu_emu.features.settings.model.Settings$MenuTag" />
    </activity>

    <action
        android:id="@+id/action_global_settingsActivity"
        app:destination="@id/settingsActivity" />
    <activity
        android:id="@+id/settingsSubscreenActivity"
        android:name="org.yuzu.yuzu_emu.features.settings.ui.SettingsSubscreenActivity"
        android:label="SettingsSubscreenActivity">
        <argument
            android:name="destination"
            app:argType="org.yuzu.yuzu_emu.features.settings.ui.SettingsSubscreen" />
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game"
            app:nullable="true"
            android:defaultValue="@null" />
    </activity>
    <action
        android:id="@+id/action_global_settingsSubscreenActivity"
        app:destination="@id/settingsSubscreenActivity" />
    <fragment
        android:id="@+id/installableFragment"
        android:name="org.yuzu.yuzu_emu.fragments.InstallableFragment"
        android:label="InstallableFragment" />
    <!-- Symbiosis screens -->
    <!--
    Стартовый экран - нативная библиотека. Раньше им был WebView с панелью,
    и именно из-за этого нельзя было понять, где что находится: половина
    интерфейса жила в HTML, половина - в Kotlin.
    -->
    <fragment
        android:id="@+id/nativeLauncherFragment"
        android:name="org.yuzu.yuzu_emu.fragments.NativeLauncherFragment"
        android:label="NativeLauncherFragment" />
    <action
        android:id="@+id/action_global_nativeLauncherFragment"
        app:destination="@id/nativeLauncherFragment"
        app:launchSingleTop="true" />
    <fragment
        android:id="@+id/manualFragment"
        android:name="org.yuzu.yuzu_emu.fragments.ManualFragment"
        android:label="ManualFragment" />
    <action
        android:id="@+id/action_global_manualFragment"
        app:destination="@id/manualFragment" />
    <fragment
        android:id="@+id/fpsTuningFragment"
        android:name="org.yuzu.yuzu_emu.fragments.FpsTuningFragment"
        android:label="FpsTuningFragment" />
    <fragment
        android:id="@+id/diagnosticsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.DiagnosticsFragment"
        android:label="DiagnosticsFragment" />
    <fragment
        android:id="@+id/keysFirmwareFragment"
        android:name="org.yuzu.yuzu_emu.fragments.KeysFirmwareFragment"
        android:label="KeysFirmwareFragment" />
    <fragment
        android:id="@+id/guideFragment"
        android:name="org.yuzu.yuzu_emu.fragments.GuideFragment"
        android:label="GuideFragment" />
    <action
        android:id="@+id/action_global_guideFragment"
        app:destination="@id/guideFragment" />
    <fragment
        android:id="@+id/livePanelFragment"
        android:name="org.yuzu.yuzu_emu.fragments.LivePanelFragment"
        android:label="LivePanelFragment" />
    <action
        android:id="@+id/action_global_livePanelFragment"
        app:destination="@id/livePanelFragment" />
    <fragment
        android:id="@+id/enginesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.EnginesFragment"
        android:label="EnginesFragment" />
    <action
        android:id="@+id/action_global_enginesFragment"
        app:destination="@id/enginesFragment" />
    <fragment
        android:id="@+id/pluginsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.PluginsFragment"
        android:label="PluginsFragment" />
    <action
        android:id="@+id/action_global_pluginsFragment"
        app:destination="@id/pluginsFragment" />
    <!--
        Сейвы одной игры и облако. Сейвы принимают путь игры аргументом:
        экран открывается и с плитки библиотеки, и из свойств игры, а
        тащить туда целый Parcelable ради двух строк незачем.
    -->
    <fragment
        android:id="@+id/savesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.SavesFragment"
        android:label="SavesFragment">
        <argument
            android:name="path"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="" />
    </fragment>
    <action
        android:id="@+id/action_global_savesFragment"
        app:destination="@id/savesFragment" />
    <fragment
        android:id="@+id/cloudFragment"
        android:name="org.yuzu.yuzu_emu.fragments.CloudFragment"
        android:label="CloudFragment" />
    <action
        android:id="@+id/action_global_cloudFragment"
        app:destination="@id/cloudFragment" />
    <fragment
        android:id="@+id/kernelLogFragment"
        android:name="org.yuzu.yuzu_emu.fragments.KernelLogFragment"
        android:label="KernelLogFragment" />
    <action
        android:id="@+id/action_global_kernelLogFragment"
        app:destination="@id/kernelLogFragment" />

    <!-- Источники: ссылка → список файлов → скачать или смотреть по частям. -->
    <fragment
        android:id="@+id/sourcesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.SourcesFragment"
        android:label="SourcesFragment" />
    <action
        android:id="@+id/action_global_sourcesFragment"
        app:destination="@id/sourcesFragment" />

    <fragment
        android:id="@+id/toolsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.ToolsFragment"
        android:label="ToolsFragment" />
    <action
        android:id="@+id/action_global_toolsFragment"
        app:destination="@id/toolsFragment" />
    <fragment
        android:id="@+id/symbiosisGameFoldersFragment"
        android:name="org.yuzu.yuzu_emu.fragments.GameFoldersFragment"
        android:label="SymbiosisGameFoldersFragment" />
    <action
        android:id="@+id/action_global_symbiosisGameFoldersFragment"
        app:destination="@id/symbiosisGameFoldersFragment" />
    <fragment
        android:id="@+id/utilitiesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.UtilitiesFragment"
        android:label="UtilitiesFragment" />
    <action
        android:id="@+id/action_global_utilitiesFragment"
        app:destination="@id/utilitiesFragment" />
    <fragment
        android:id="@+id/homebrewFragment"
        android:name="org.yuzu.yuzu_emu.fragments.HomebrewFragment"
        android:label="HomebrewFragment" />
    <action
        android:id="@+id/action_global_homebrewFragment"
        app:destination="@id/homebrewFragment" />
    <fragment
        android:id="@+id/launchersFragment"
        android:name="org.yuzu.yuzu_emu.fragments.LaunchersFragment"
        android:label="LaunchersFragment" />
    <action
        android:id="@+id/action_global_launchersFragment"
        app:destination="@id/launchersFragment" />
    <action
        android:id="@+id/action_global_fpsTuningFragment"
        app:destination="@id/fpsTuningFragment" />
    <action
        android:id="@+id/action_global_diagnosticsFragment"
        app:destination="@id/diagnosticsFragment" />
    <action
        android:id="@+id/action_global_keysFirmwareFragment"
        app:destination="@id/keysFirmwareFragment" />
    <action
        android:id="@+id/action_global_installableFragment"
        app:destination="@id/installableFragment" />
    <fragment
        android:id="@+id/driverManagerFragment"
        android:name="org.yuzu.yuzu_emu.fragments.DriverManagerFragment"
        android:label="DriverManagerFragment" >
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/appletLauncherFragment"
        android:name="org.yuzu.yuzu_emu.fragments.AppletLauncherFragment"
        android:label="AppletLauncherFragment" >
        <action
            android:id="@+id/action_appletLauncherFragment_to_cabinetLauncherDialogFragment"
            app:destination="@id/cabinetLauncherDialogFragment" />
    </fragment>
    <dialog
        android:id="@+id/cabinetLauncherDialogFragment"
        android:name="org.yuzu.yuzu_emu.fragments.CabinetLauncherDialogFragment"
        android:label="CabinetLauncherDialogFragment" />
    <fragment
        android:id="@+id/gameFoldersFragment"
        android:name="org.yuzu.yuzu_emu.fragments.GameFoldersFragment"
        android:label="GameFoldersFragment" />
    <fragment
        android:id="@+id/perGamePropertiesFragment"
        android:name="org.yuzu.yuzu_emu.fragments.GamePropertiesFragment"
        android:label="PerGamePropertiesFragment" >
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game" />
        <action
            android:id="@+id/action_perGamePropertiesFragment_to_gameInfoFragment"
            app:destination="@id/gameInfoFragment" />
        <action
            android:id="@+id/action_perGamePropertiesFragment_to_addonsFragment"
            app:destination="@id/addonsFragment" />
        <action
            android:id="@+id/action_perGamePropertiesFragment_to_driverManagerFragment"
            app:destination="@id/driverManagerFragment" />
        <action
            android:id="@+id/action_perGamePropertiesFragment_to_freedrenoSettingsFragment"
            app:destination="@id/freedrenoSettingsFragment" />
    </fragment>
    <action
        android:id="@+id/action_global_perGamePropertiesFragment"
        app:destination="@id/perGamePropertiesFragment"
        app:popUpTo="@id/nativeLauncherFragment"
        app:popUpToInclusive="false" />
    <fragment
        android:id="@+id/gameInfoFragment"
        android:name="org.yuzu.yuzu_emu.fragments.GameInfoFragment"
        android:label="GameInfoFragment" >
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game" />
    </fragment>
    <fragment
        android:id="@+id/addonsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.AddonsFragment"
        android:label="AddonsFragment" >
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game" />
    </fragment>
    <fragment
        android:id="@+id/driverFetcherFragment"
        android:name="org.yuzu.yuzu_emu.fragments.DriverFetcherFragment"
        android:label="fragment_driver_fetcher"
        tools:layout="@layout/fragment_driver_fetcher" />
    <fragment
        android:id="@+id/freedrenoSettingsFragment"
        android:name="org.yuzu.yuzu_emu.fragments.FreedrenoSettingsFragment"
        android:label="@string/freedreno_settings_title">
        <argument
            android:name="game"
            app:argType="org.yuzu.yuzu_emu.model.Game"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>
    <fragment
        android:id="@+id/profileManagerFragment"
        android:name="org.yuzu.yuzu_emu.fragments.ProfileManagerFragment"
        android:label="ProfileManagerFragment" >
        <action
            android:id="@+id/action_profileManagerFragment_to_newUserDialog"
            app:destination="@id/newUserDialogFragment" />
    </fragment>
    <fragment
        android:id="@+id/newUserDialogFragment"
        android:name="org.yuzu.yuzu_emu.fragments.EditUserDialogFragment"
        android:label="NewUserDialogFragment" />

</navigation>
