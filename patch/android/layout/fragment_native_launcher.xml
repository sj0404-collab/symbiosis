Native launcher: the screen the app opens on.

It replaces the WebView page that used to be the whole start screen. That
page had half of its logic in JavaScript and the other half in Kotlin, and
the result was exactly the complaint it earned: "I cannot tell where
anything is". Here every row is a real Android view, every button is a real
button, and the row layout comes from NativeLibraryPresenter, which the host
test can check without an emulator.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinator_launcher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sym_screen">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_launcher"
        style="@style/Widget.Eden.TransparentTopAppBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar_launcher"
            style="@style/Widget.Eden.TransparentTopToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:subtitle="@string/launcher_subtitle"
            app:title="@string/launcher_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!--
        Actions, not a hamburger menu. The whole point of the rewrite was that
        a person could not find things; a menu would hide them again.
        -->
        <HorizontalScrollView
            android:id="@+id/scroll_launcher_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_rescan"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/launcher_rescan" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_folders"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/launcher_action_folders" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_convert"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/launcher_action_convert" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_keys"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/launcher_action_keys" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_tools"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:minWidth="0dp"
                    android:text="@string/launcher_action_tools" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_launcher_help"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/launcher_action_help" />

            </LinearLayout>

        </HorizontalScrollView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_launcher_search"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:hint="@string/launcher_search_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_launcher_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />

        </com.google.android.material.textfield.TextInputLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips_launcher_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

        </HorizontalScrollView>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_launcher_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="12 игр · 3 обновления · 40 сжатых → Конвертер" />

        <!--
        Сообщение плагина. Отдельная строка под сводкой, а не внутри неё:
        сводка отвечает «сколько игр», плашка — «что с ними не так». Цвет
        ставится по важности сообщения (SymbiosisTheme).
        -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/text_launcher_plugin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:padding="10dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:visibility="gone"
            tools:text="Памяти меньше 6 ГБ: второму ядру может не хватить места рядом с игрой."
            tools:visibility="visible" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_launcher"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/list_launcher"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingHorizontal="12dp"
                    android:paddingBottom="24dp"
                    android:scrollbars="vertical" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/text_launcher_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="28dp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone"
                    tools:text="Папка не выбрана или пуста: «Папки» → добавить папку с играми."
                    tools:visibility="visible" />

            </FrameLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
