<!--
SPDX-FileCopyrightText: Copyright 2026 Eden Symbiosis Project
SPDX-License-Identifier: GPL-3.0-or-later

A button under a manual section. Separate file because the style has to exist
at inflation time: building a MaterialButton in code without a defStyleAttr
produces an unstyled grey button that ignores the app theme, which is exactly
how the old panel looked.
-->
<com.google.android.material.button.MaterialButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.Material3.Button.TonalButton"
    android:id="@+id/button_manual_action"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="0dp"
    android:minHeight="40dp"
    android:insetTop="0dp"
    android:insetBottom="0dp" />
