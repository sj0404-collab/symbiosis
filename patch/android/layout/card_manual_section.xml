SPDX-License-Identifier: GPL-3.0-or-later

One section of the manual: a title, a sentence about why it matters, then the
steps. Cards rather than one long wall of text, because the question this
screen answers is "where do I go next", and each section is one answer.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_manual_section"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Полоса цвета раздела: ставится в ManualFragment из SymbiosisTheme. -->
        <View
            android:id="@+id/view_manual_accent"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:background="?attr/colorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/text_manual_section_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorPrimary"
            tools:text="С чего начать: три шага" />

        <TextView
            android:id="@+id/text_manual_section_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Порядок важен: пока нет ключей, ни один дамп не откроется." />

        <LinearLayout
            android:id="@+id/container_manual_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/container_manual_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal" />

    </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
